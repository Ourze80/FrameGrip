<Window x:Class="FrameGrip.CloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FrameGrip"
        Title="FrameGrip" Icon="Assets/app.ico" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <StackPanel Margin="24,22,24,22">
        <TextBlock Text="{local:T Close.Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
        <TextBlock Foreground="{DynamicResource FgDim}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="{local:T Close.Body}"/>
        <Button Style="{StaticResource AccentButton}" Content="{local:T Close.Hide}" Click="Hide_Click"
                IsDefault="True" Margin="0,20,0,0" Padding="12,9"/>
        <Button Style="{StaticResource DarkButton}" Content="{local:T Close.Exit}" Click="Exit_Click" Margin="0,8,0,0" Padding="12,9"/>
        <TextBlock Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                   Text="{local:T Close.Remember}"/>
    </StackPanel>
</Window>
