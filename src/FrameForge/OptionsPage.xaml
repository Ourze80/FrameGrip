<UserControl x:Class="FrameGrip.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrameGrip"
             Foreground="{DynamicResource Fg}">
    <Grid>
        <StackPanel>
            <!-- LINGUA: i nomi delle lingue restano sempre gli stessi, così si ritrova la propria. -->
            <DockPanel Margin="0,18,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="LangEn" Style="{StaticResource Chip}" Content="English" Margin="8,0,0,0" Click="LangEn_Click"/>
                    <CheckBox x:Name="LangIt" Style="{StaticResource Chip}" Content="Italiano" Margin="8,0,0,0" Click="LangIt_Click"/>
                </StackPanel>
                <TextBlock Text="{local:T Options.Language}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="{local:T Options.AppliesNow}" Foreground="{DynamicResource FgDim}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>

            <!-- ASPETTO -->
            <TextBlock Text="{local:T Sec.Appearance}" Style="{StaticResource Section}" Margin="0,22,0,8"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ThemeDark" Style="{StaticResource Chip}" Content="{local:T Theme.Dark}" Margin="8,0,0,0" Click="ThemeDark_Click"/>
                    <CheckBox x:Name="ThemeLight" Style="{StaticResource Chip}" Content="{local:T Theme.Light}" Margin="8,0,0,0" Click="ThemeLight_Click"/>
                </StackPanel>
                <TextBlock Text="{local:T Options.Theme}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{local:T Options.AppColor}" FontSize="14" VerticalAlignment="Top" Margin="0,4,12,0"
                           TextWrapping="Wrap" MaxWidth="130"/>
                <WrapPanel x:Name="AccentPanel" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,-8,-8"/>
            </Grid>

            <!-- GENERALE -->
            <TextBlock Text="{local:T Sec.General}" Style="{StaticResource Section}" Margin="0,22,0,8"/>
            <CheckBox x:Name="AutostartToggle" Content="{local:T Options.Autostart}" Style="{StaticResource Toggle}"
                      Click="Autostart_Click" IsEnabled="False"/>
            <TextBlock Text="{local:T Options.AutostartHelp}" Foreground="{DynamicResource FgDim}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,52,0"/>
            <TextBlock x:Name="AutostartStatus" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,4,0,0"/>
            <CheckBox Content="{local:T Options.KeepRunning}" Style="{StaticResource Toggle}" Margin="0,14,0,0"
                      IsChecked="{Binding HideOnClose}"/>
            <TextBlock Text="{local:T Options.KeepRunningHelp}" Foreground="{DynamicResource FgDim}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,52,0"/>

            <!-- SCHERMO: G-Sync / FreeSync è una cosa dello schermo, non del gioco: si sceglie una volta qui. -->
            <StackPanel x:Name="DisplaySection">
                <TextBlock Text="{local:T Sec.Display}" Style="{StaticResource Section}" Margin="0,22,0,8"/>
                <TextBlock x:Name="DisplayName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DisplayMode" Foreground="{DynamicResource FgDim}" FontSize="12" Margin="0,2,0,0"/>
                <DockPanel Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="VrrYes" Style="{StaticResource Chip}" Content="{local:T Ideal.Yes}" Margin="8,0,0,0" Click="Vrr_Click"/>
                        <CheckBox x:Name="VrrNo" Style="{StaticResource Chip}" Content="{local:T Ideal.No}" Margin="8,0,0,0" Click="Vrr_Click"/>
                        <CheckBox x:Name="VrrUnknown" Style="{StaticResource Chip}" Content="{local:T Display.DontKnow}" Margin="8,0,0,0" Click="Vrr_Click"/>
                    </StackPanel>
                    <TextBlock Text="{local:T Display.Vrr}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{local:T Display.VrrHelp}" Foreground="{DynamicResource FgDim}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6,52,0"/>
            </StackPanel>

            <!-- TASTI RAPIDI: tutti i tasti dell'app; funzionano anche dentro i giochi. -->
            <TextBlock x:Name="HotkeysTitle" Text="{local:T Ovl.Keys}" Style="{StaticResource Section}" Margin="0,22,0,10"/>
            <ContentControl x:Name="HotkeysHost" Focusable="False"/>

            <StackPanel x:Name="GuideRow">
                <TextBlock Text="{local:T Rail.Help}" Style="{StaticResource Section}" Margin="0,22,0,8"/>
                <Button x:Name="GuideButton" Style="{StaticResource DarkButton}" Content="{local:T Options.ReplayGuide}"
                        HorizontalAlignment="Left" Padding="14,6" Click="GuideButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Selettore dei colori per "Altri colori…": lo stesso controllo usato per le voci dell'overlay. -->
        <Popup x:Name="ColorPopup" StaysOpen="True" Placement="Bottom" AllowsTransparency="True">
            <local:ColorPicker x:Name="Picker"/>
        </Popup>
    </Grid>
</UserControl>
