<UserControl x:Class="FrameGrip.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrameGrip">
    <!-- Selettore dei colori: tavolozza, tre cursori e codice. Lo ospita in un Popup la finestra che ne ha bisogno. -->
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
            CornerRadius="12" Padding="14" Margin="0,4,0,0">
        <StackPanel Width="232">
            <WrapPanel x:Name="PalettePanel"/>

            <!-- Qualsiasi tonalità: tre cursori, il colore cambia mentre li muovi. -->
            <TextBlock Text="{local:T Picker.Hue}" Foreground="{DynamicResource FgDim}" FontSize="12" Margin="0,8,0,3"/>
            <!-- La striscia dei colori non segue il tema dell'app. -->
            <Border Height="8" CornerRadius="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.167"/>
                        <GradientStop Color="#00FF00" Offset="0.333"/>
                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                        <GradientStop Color="#0000FF" Offset="0.667"/>
                        <GradientStop Color="#FF00FF" Offset="0.833"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider x:Name="HueSlider" Style="{StaticResource PlainSlider}" Minimum="0" Maximum="360" ValueChanged="Hsv_Changed"/>
            <TextBlock Text="{local:T Picker.Saturation}" Foreground="{DynamicResource FgDim}" FontSize="12" Margin="0,4,0,0"/>
            <Slider x:Name="SatSlider" Minimum="0" Maximum="100" ValueChanged="Hsv_Changed"/>
            <TextBlock Text="{local:T Picker.Brightness}" Foreground="{DynamicResource FgDim}" FontSize="12" Margin="0,4,0,0"/>
            <Slider x:Name="ValSlider" Minimum="0" Maximum="100" ValueChanged="Hsv_Changed"/>
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="{local:T Picker.Apply}" Click="HexOk_Click" Margin="6,0,0,0"/>
                <TextBlock Text="{local:T Picker.Code}" Foreground="{DynamicResource FgDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="HexBox" Style="{StaticResource DarkBox}" MaxLength="7" ToolTip="{local:T Picker.Example}"/>
            </DockPanel>
            <Button Style="{StaticResource DarkButton}" Content="{local:T Picker.UseTheme}" Click="ColorAuto_Click" Margin="0,8,0,0"/>
            <Button Style="{StaticResource AccentButton}" Content="{local:T Picker.Done}" Click="ColorDone_Click" Margin="0,8,0,0"
                    ToolTip="{local:T Picker.DoneTip}"/>
        </StackPanel>
    </Border>
</UserControl>
