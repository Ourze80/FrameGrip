                        <ColumnDefinition x:Name="ColTree" Width="0.27*" MinWidth="290"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition x:Name="ColEntries" Width="0.47*" MinWidth="500"/>
                        <ColumnDefinition x:Name="ColSensGap" Width="20"/>
                        <ColumnDefinition x:Name="ColSensPreview" Width="0.26*" MinWidth="260" MaxWidth="1100"/>
