                                    <Border x:Name="TreeBox" Style="{StaticResource Card}" Padding="8" Height="460" Visibility="Collapsed">
                                        <Grid>
                                            <TextBlock x:Name="SensorsEmpty" Text="{local:T Main.Detecting}" Foreground="{DynamicResource FgDim}"
