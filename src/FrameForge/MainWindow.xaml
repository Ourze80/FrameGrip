<Window x:Class="FrameGrip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FrameGrip"
        Title="FrameGrip" Icon="Assets/app.ico" Width="1440" Height="920" MinWidth="1180" MinHeight="700"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:LocKeyConverter x:Key="LocKey"/>
        <!-- Maniglia per trascinare una riga della lista "Customize": quasi invisibile, si accende passando sulla riga. -->
        <Style x:Key="DragGrip" TargetType="TextBlock">
            <Setter Property="Text" Value="⋮⋮"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Opacity" Value="0.25"/>
            <Setter Property="ToolTip" Value="{local:T Entry.Drag}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Pulsanti di una riga della lista "Nell'overlay": tenui, si accendono passando sulla riga o con la tastiera. -->
        <Style x:Key="RowMini" TargetType="Button" BasedOn="{StaticResource MiniButton}">
            <Setter Property="Opacity" Value="0.3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BARRA A SINISTRA: le tre pagine in alto, guida e opzioni in basso. -->
        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="22,20,12,0">
                    <Viewbox Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Canvas Width="256" Height="256">
                            <Rectangle Width="240" Height="240" Canvas.Left="8" Canvas.Top="8" RadiusX="56" RadiusY="56"
                                       Fill="{DynamicResource Control}" Stroke="{DynamicResource LineStrong}" StrokeThickness="4"/>
                            <Polyline Points="92,60 58,60 58,196 92,196" Stroke="{DynamicResource Accent}" StrokeThickness="24"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Polyline Points="164,60 198,60 198,196 164,196" Stroke="{DynamicResource Accent}" StrokeThickness="24"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Rectangle Width="16" Height="72" Canvas.Left="96" Canvas.Top="92" RadiusX="8" RadiusY="8" Fill="{DynamicResource Fg}"/>
                            <Rectangle Width="16" Height="72" Canvas.Left="120" Canvas.Top="92" RadiusX="8" RadiusY="8" Fill="{DynamicResource Fg}"/>
                            <Rectangle Width="16" Height="72" Canvas.Left="144" Canvas.Top="92" RadiusX="8" RadiusY="8" Fill="{DynamicResource Fg}"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="FrameGrip" FontSize="19" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock Text="{local:T Main.Subtitle}" Foreground="{DynamicResource FgDim}" FontSize="11.5"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,0">
                    <Border Height="1" Background="{DynamicResource Line}" Margin="8,0,8,10"/>
                    <Button x:Name="NavHelp" Style="{StaticResource RailAction}" Height="40" Click="NavHelp_Click"
                            AutomationProperties.Name="{local:T Rail.Help}">
                        <StackPanel Orientation="Horizontal" Margin="22,0,8,0">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE897;" FontSize="16" Width="32"/>
                            <TextBlock Style="{StaticResource RailLabel}" Text="{local:T Rail.Help}" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <RadioButton x:Name="NavOptions" Style="{StaticResource RailButton}" Height="40" Checked="Nav_Checked"
                                 AutomationProperties.Name="{local:T Options.Title}">
                        <StackPanel Orientation="Horizontal" Margin="22,0,8,0">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE713;" FontSize="16" Width="32"/>
                            <TextBlock Style="{StaticResource RailLabel}" Text="{local:T Options.Title}" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource FgDim}" FontSize="11" Margin="10,10,0,14"/>
                </StackPanel>

                <StackPanel Margin="12,26,12,0">
                    <RadioButton x:Name="NavGames" Style="{StaticResource RailButton}" Height="52" Checked="Nav_Checked" Click="NavGames_Click"
                                 AutomationProperties.Name="{local:T Rail.Games}">
                        <DockPanel Margin="22,0,8,0">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE7FC;" Width="32"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RailLabel}" Text="{local:T Rail.Games}"/>
                                <TextBlock Text="{local:T Rail.GamesHint}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavOverlay" Style="{StaticResource RailButton}" Height="52" Checked="Nav_Checked"
                                 AutomationProperties.Name="{local:T Rail.Overlay}">
                        <DockPanel Margin="22,0,8,0">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE7F4;" Width="32"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RailLabel}" Text="{local:T Rail.Overlay}"/>
                                <TextBlock Text="{local:T Rail.OverlayHint}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSensors" Style="{StaticResource RailButton}" Height="52" Checked="Nav_Checked"
                                 AutomationProperties.Name="{local:T Rail.Sensors}">
                        <DockPanel Margin="22,0,8,0">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE9D9;" Width="32"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RailLabel}" Text="{local:T Rail.Sensors}"/>
                                <TextBlock Text="{local:T Rail.SensorsHint}" Foreground="{DynamicResource FgDim}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA DI STATO: sempre visibile, qualsiasi pagina sia aperta. -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="28,0,24,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="WarnChip" Style="{StaticResource StatusChip}" Visibility="Collapsed" Margin="0,0,10,0"
                                Background="{DynamicResource WarnSoft}" Click="WarnChip_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource Warn}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WarnText" FontSize="12.5" Margin="8,0,0,0" MaxWidth="220"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource StatusBox}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="StatusOverlay" Style="{StaticResource Toggle}" Content="Overlay" FontSize="12.5"
                                          FontWeight="SemiBold" IsChecked="{Binding OverlayEnabled}"
                                          AutomationProperties.Name="{local:T Main.ShowOverlay}" ToolTip="{local:T Main.ShowOverlay}"/>
                                <TextBlock x:Name="StatusKeyLabel" Text="{local:T Status.Key}" Foreground="{DynamicResource FgDim}" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,1" VerticalAlignment="Center" ToolTip="{local:T Main.ShowHide}">
                                    <TextBlock Text="{Binding HotkeyName}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Button x:Name="LimitChip" Style="{StaticResource StatusChip}" Margin="10,0,0,0" Click="LimitChip_Click"
                                ToolTip="{local:T Status.LimitTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LimitChipText" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LimitChipScope" FontSize="11.5" Foreground="{DynamicResource FgDim}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StatusRecord" Style="{StaticResource StatusChip}" Margin="10,0,0,0" MinWidth="112"
                                Click="RecordButton_Click" ToolTip="{local:T Status.RecordTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource Danger}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusRecordText" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse x:Name="GameRing" StrokeThickness="1.5" Opacity="0.5"/>
                        <Ellipse x:Name="GameDot" Width="10" Height="10"/>
                    </Grid>
                    <TextBlock x:Name="GameText" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,0"/>
                </DockPanel>
            </Border>

            <!-- Titolo della pagina aperta: lo scrive il codice. -->
            <DockPanel x:Name="PageHeader" Grid.Row="1" Margin="28,18,28,16">
                <ContentControl x:Name="HeaderTools" DockPanel.Dock="Right" Focusable="False" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <TextBlock x:Name="PageSub" FontSize="13.5" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2" Margin="28,0,28,24">
                <!-- GIOCHI: l'elenco dei giochi e la pagina di ciascuno (costruiti dal codice, vedi GamesPage). -->
                <Grid x:Name="PageGames">
                    <ContentControl x:Name="GamesHost" Focusable="False"/>
                    <!-- Registrazione di una sessione: il codice la sposta nella pagina del gioco. -->
                    <StackPanel x:Name="RecordPanel" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="OpenBenchFolder" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                    Click="OpenBenchFolder_Click" VerticalAlignment="Center" Padding="0,2"
                                    AutomationProperties.Name="{local:T Bench.OpenFolder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{local:T Bench.OpenFolder}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentText}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RecordButton" Style="{StaticResource DarkButton}" Content="{local:T Bench.Start}"
                                    Click="RecordButton_Click" Padding="14,7" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{local:T Game.OrPress}" Foreground="{DynamicResource FgDim}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="{DynamicResource Control}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RecordName}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Button Style="{StaticResource LinkButton}" Click="GoHotkeys_Click" Padding="0,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Content="{local:T Keys.Change}" FontSize="12" Foreground="{DynamicResource AccentText}"
                                        AutomationProperties.Name="{local:T Keys.Open}" ToolTip="{local:T Keys.Open}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="BenchText" Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas" Margin="0,12,0,0"
                                   Text="{local:T Bench.Intro}"/>
                    </StackPanel>
                </Grid>

                <!-- OVERLAY: aspetto a sinistra, anteprima grande a destra. -->
                <Grid x:Name="PageOverlay" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <!-- in quote (*): l'anteprima cresce con la finestra; la barra in mezzo la allarga o la stringe -->
                        <ColumnDefinition x:Name="ColLook" Width="0.66*" MinWidth="420"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition x:Name="ColOvlPreview" Width="0.34*" MinWidth="300" MaxWidth="1100"/>
                    </Grid.ColumnDefinitions>
                    <GridSplitter x:Name="OvlSplitter" Grid.Column="1" Style="{StaticResource PanelSplitterV}" MouseDoubleClick="Splitter_Reset"
                                  DragCompleted="Splitter_DragCompleted" ToolTip="{local:T Main.SplitterTip}"
                                  AutomationProperties.Name="{local:T Main.SplitterTip}"/>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="PageLook" Margin="0,0,10,0">
                            <!-- STILE: i nomi degli stili restano in inglese in tutte le lingue. -->
                            <Border Style="{StaticResource PageCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Text="&#xF0E2;" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="{local:T Ovl.Style}" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <ListBox x:Name="StyleList" Style="{StaticResource CardList}" SelectedIndex="{Binding Layout}">
                                        <ListBoxItem>
                                            <StackPanel Width="68">
                                                <!-- Miniature degli stili: seguono il tema dell'app per restare visibili anche sul chiaro. -->
                                                <Canvas Width="64" Height="36">
                                                    <Rectangle Canvas.Left="0" Canvas.Top="1" Width="30" Height="5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="50" Canvas.Top="1" Width="14" Height="5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="0" Canvas.Top="11" Width="24" Height="5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="50" Canvas.Top="11" Width="14" Height="5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="0" Canvas.Top="21" Width="34" Height="5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="50" Canvas.Top="21" Width="14" Height="5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="0" Canvas.Top="31" Width="20" Height="5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="50" Canvas.Top="31" Width="14" Height="5" Fill="{DynamicResource Fg}"/>
                                                </Canvas>
                                                <TextBlock Text="{local:T Layout.List}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem>
                                            <StackPanel Width="68">
                                                <Canvas Width="64" Height="36">
                                                    <Rectangle Canvas.Left="0" Canvas.Top="13" Width="64" Height="10" Fill="{DynamicResource LineStrong}" RadiusX="3" RadiusY="3"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="16" Width="6" Height="4" Fill="#7CE38B"/>
                                                    <Rectangle Canvas.Left="13" Canvas.Top="16" Width="9" Height="4" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="27" Canvas.Top="16" Width="6" Height="4" Fill="#5CC8FF"/>
                                                    <Rectangle Canvas.Left="36" Canvas.Top="16" Width="9" Height="4" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="50" Canvas.Top="16" Width="6" Height="4" Fill="#FFB454"/>
                                                </Canvas>
                                                <TextBlock Text="{local:T Layout.Bar}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <!-- Grid HUD: tabella fitta, una riga per sensore, componenti nell'ordine dell'utente. -->
                                        <ListBoxItem>
                                            <StackPanel Width="68">
                                                <Canvas Width="64" Height="36">
                                                    <Rectangle Canvas.Left="0" Canvas.Top="1" Width="2" Height="5" Fill="#7CE38B"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="2" Width="14" Height="3" Fill="#7CE38B"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="9" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="24" Canvas.Top="9" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="14" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="24" Canvas.Top="14" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="19" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="24" Canvas.Top="19" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="24" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="24" Canvas.Top="24" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="29" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="24" Canvas.Top="29" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="33" Canvas.Top="1" Width="2" Height="5" Fill="#5CC8FF"/>
                                                    <Rectangle Canvas.Left="37" Canvas.Top="2" Width="14" Height="3" Fill="#5CC8FF"/>
                                                    <Rectangle Canvas.Left="37" Canvas.Top="9" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="57" Canvas.Top="9" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="37" Canvas.Top="14" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="57" Canvas.Top="14" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="37" Canvas.Top="19" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="57" Canvas.Top="19" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="37" Canvas.Top="24" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="57" Canvas.Top="24" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                    <Rectangle Canvas.Left="37" Canvas.Top="29" Width="16" Height="2.5" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="57" Canvas.Top="29" Width="6" Height="2.5" Fill="{DynamicResource FgDim}"/>
                                                </Canvas>
                                                <TextBlock Text="{local:T Layout.Grid}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <!-- Console: terminale a caratteri fissi, "[ gpu ]" e voci con i puntini, colonne tra un componente e l'altro. -->
                                        <ListBoxItem>
                                            <StackPanel Width="68">
                                                <Canvas Width="64" Height="36">
                                                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="64" Height="36" Stroke="#39FF7A" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="4" Width="10" Height="3" Fill="#39FF7A"/>
                                                    <Rectangle Canvas.Left="16" Canvas.Top="4" Width="22" Height="3" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="11" Width="14" Height="2.5" Fill="#7CE38B"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="17.0" Width="9" Height="2" Fill="#B7E8C4"/>
                                                    <Rectangle Canvas.Left="14" Canvas.Top="17.0" Width="8" Height="2" Fill="#2E6A48"/>
                                                    <Rectangle Canvas.Left="23" Canvas.Top="17.0" Width="6" Height="2" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="21.5" Width="9" Height="2" Fill="#B7E8C4"/>
                                                    <Rectangle Canvas.Left="14" Canvas.Top="21.5" Width="8" Height="2" Fill="#2E6A48"/>
                                                    <Rectangle Canvas.Left="23" Canvas.Top="21.5" Width="6" Height="2" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="26.0" Width="9" Height="2" Fill="#B7E8C4"/>
                                                    <Rectangle Canvas.Left="14" Canvas.Top="26.0" Width="8" Height="2" Fill="#2E6A48"/>
                                                    <Rectangle Canvas.Left="23" Canvas.Top="26.0" Width="6" Height="2" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="4" Canvas.Top="30.5" Width="9" Height="2" Fill="#B7E8C4"/>
                                                    <Rectangle Canvas.Left="14" Canvas.Top="30.5" Width="8" Height="2" Fill="#2E6A48"/>
                                                    <Rectangle Canvas.Left="23" Canvas.Top="30.5" Width="6" Height="2" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="34" Canvas.Top="11" Width="14" Height="2.5" Fill="#5CC8FF"/>
                                                    <Rectangle Canvas.Left="34" Canvas.Top="17.0" Width="9" Height="2" Fill="#B7E8C4"/>
                                                    <Rectangle Canvas.Left="44" Canvas.Top="17.0" Width="8" Height="2" Fill="#2E6A48"/>
                                                    <Rectangle Canvas.Left="53" Canvas.Top="17.0" Width="6" Height="2" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="34" Canvas.Top="21.5" Width="9" Height="2" Fill="#B7E8C4"/>
                                                    <Rectangle Canvas.Left="44" Canvas.Top="21.5" Width="8" Height="2" Fill="#2E6A48"/>
                                                    <Rectangle Canvas.Left="53" Canvas.Top="21.5" Width="6" Height="2" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="34" Canvas.Top="26.0" Width="9" Height="2" Fill="#B7E8C4"/>
                                                    <Rectangle Canvas.Left="44" Canvas.Top="26.0" Width="8" Height="2" Fill="#2E6A48"/>
                                                    <Rectangle Canvas.Left="53" Canvas.Top="26.0" Width="6" Height="2" Fill="{DynamicResource Fg}"/>
                                                    <Rectangle Canvas.Left="34" Canvas.Top="30.5" Width="9" Height="2" Fill="#B7E8C4"/>
                                                    <Rectangle Canvas.Left="44" Canvas.Top="30.5" Width="8" Height="2" Fill="#2E6A48"/>
                                                    <Rectangle Canvas.Left="53" Canvas.Top="30.5" Width="6" Height="2" Fill="{DynamicResource Fg}"/>
