                                                <TreeView.Resources>
                                                    <!-- I colori di selezione (SystemColors) li mette il codice secondo il tema: vedi UpdateTreeHighlight. -->
                                                    <Style TargetType="TreeViewItem">
                                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                        <Setter Property="Visibility" Value="{Binding Vis}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                                    </Style>

                                                    <HierarchicalDataTemplate DataType="{x:Type local:HardwareNode}" ItemsSource="{Binding Children}">
                                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                                            <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource AccentText}" FontWeight="Bold"
                                                                       FontSize="12" Width="38" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                        </StackPanel>
                                                    </HierarchicalDataTemplate>

                                                    <DataTemplate DataType="{x:Type local:SensorNode}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3" Width="200">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            </CheckBox>
                                                            <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource FgDim}" FontSize="12"
                                                                       Width="110" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ValueText}" Width="84" TextAlignment="Right"
                                                                       FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </TreeView.Resources>
                                            </TreeView>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <!-- 2 · NELL'OVERLAY: le righe scelte, da riordinare, rinominare e colorare. -->
                    <Border Grid.Column="2" Style="{StaticResource PageCard}" Margin="0" Padding="18,16,8,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,10,10">
                                <DockPanel>
                                    <!-- finestra stretta: l'anteprima si apre e si chiude da qui -->
                                    <ToggleButton x:Name="SensPreviewToggle" DockPanel.Dock="Right" Visibility="Collapsed" Checked="SensPreviewToggle_Click" Unchecked="SensPreviewToggle_Click"
                                                  Cursor="Hand" AutomationProperties.Name="{local:T Sns.Preview}" ToolTip="{local:T Sns.PreviewTip}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="B" CornerRadius="8" Padding="10,5" BorderThickness="1"
                                                        Background="{DynamicResource Control}" BorderBrush="{DynamicResource Line}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{local:T Sns.Preview}" FontSize="12.5" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="{local:T Sns.InOverlay}" Style="{StaticResource CardTitle}"/>
                                </DockPanel>
                                <TextBlock Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{local:T Main.CustomizeHelp}"/>
                            </StackPanel>
                            <ScrollViewer x:Name="EntryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                <!-- Le righe si riordinano anche trascinandole con il mouse (vedi "trascinamento" nel codice). -->
                                <ItemsControl x:Name="EntryList" PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="EntryList_PreviewMouseMove" PreviewMouseLeftButtonUp="EntryList_PreviewMouseLeftButtonUp"
                                              LostMouseCapture="EntryList_LostMouseCapture">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type local:ToggleEntry}">
                                            <StackPanel Margin="38,10,0,3" Opacity="{Binding RowOpacity}">
                                                <CheckBox IsChecked="{Binding IsShown}" ToolTip="{local:T Entry.ShowHide}">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                                </CheckBox>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="11.5"
                                                           TextWrapping="Wrap" Margin="27,2,0,4"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type local:GroupEntry}">
                                            <StackPanel Margin="0,8,0,3" Opacity="{Binding RowOpacity}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource DragGrip}" Visibility="{Binding GripVis}"/>
                                                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource ExpandArrow}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              Visibility="{Binding ArrowVis}" ToolTip="{Binding ExpandTip}"
                                                              AutomationProperties.Name="{Binding ExpandName}" VerticalAlignment="Center"/>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsShown}" Visibility="{Binding ToggleVis}" Margin="0,0,8,0"
                                                          VerticalAlignment="Center" ToolTip="{local:T Entry.ShowHide}"/>
                                                <Button DockPanel.Dock="Left" Style="{StaticResource Swatch}" Background="{Binding ColorBrush}" Click="Swatch_Click"
                                                        ToolTip="{local:T Entry.LabelColor}"/>
                                                <!-- a destra, dall'esterno verso l'interno -->
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="↓" Click="GroupDown_Click"
                                                        Visibility="{Binding MoveVis}" ToolTip="{local:T Entry.RowDown}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="↑" Click="GroupUp_Click" Margin="8,0,0,0"
                                                        Visibility="{Binding MoveVis}" ToolTip="{local:T Entry.RowUp}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="A+" Click="SizeUp_Click"
                                                        Margin="0" ToolTip="{local:T Entry.RowLarger}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Width="36" TextAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="A−" Click="SizeDown_Click"
                                                        Margin="8,0,0,0" ToolTip="{local:T Entry.RowSmaller}"/>
                                                <!-- "Nome modello" come icona: il testo intero è nel suggerimento e nel nome letto dal lettore di schermo -->
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="&#xE8AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                        FontSize="12" Click="UseHardwareName_Click" Visibility="{Binding MoveVis}" Margin="6,0,0,0"
                                                        AutomationProperties.Name="{local:T Entry.ModelName}">
                                                    <Button.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{local:T Entry.ModelName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding HardwareName}"/>
                                                        </StackPanel>
                                                    </Button.ToolTip>
                                                </Button>
                                                <!-- il nome prende lo spazio che resta, fino a 170 px, sempre allineato a sinistra -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="90" MaxWidth="170"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource DarkBox}" FontWeight="Bold" MaxLength="40"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" LostFocus="NameBox_LostFocus"
                                                             ToolTip="{local:T Entry.RowLabel}"/>
                                                </Grid>
                                            </DockPanel>
                                            <!-- A gruppo chiuso, sotto il nome: quante voci contiene (a destra finirebbe fuori dal riquadro). -->
                                            <TextBlock Text="{Binding CountText}" Visibility="{Binding CountVis}" Foreground="{DynamicResource FgDim}"
                                                       FontSize="12" Margin="65,2,0,2"/>
                                            <TextBlock Text="{Binding Description}" Visibility="{Binding DescriptionVis}" Foreground="{DynamicResource FgDim}"
                                                       FontSize="11.5" TextWrapping="Wrap" Margin="65,2,0,2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type local:SensorEntry}">
                                            <StackPanel Margin="28,2,0,2" Visibility="{Binding RowVis}">
                                            <DockPanel LastChildFill="True" Opacity="{Binding RowOpacity}">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource DragGrip}"/>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsShown}" Visibility="{Binding FrameVis}" Margin="0,0,8,0"
                                                          VerticalAlignment="Center" ToolTip="{local:T Entry.ShowHideValue}"/>
                                                <Button DockPanel.Dock="Left" Style="{StaticResource Swatch}" Background="{Binding ColorBrush}" Click="Swatch_Click"
                                                        ToolTip="{local:T Entry.ValueColor}"/>
                                                <!-- a destra, dall'esterno verso l'interno; la ✕ tiene il suo posto anche quando manca, così le colonne restano allineate -->
                                                <Grid DockPanel.Dock="Right" Width="26">
                                                    <Button Style="{StaticResource RowMini}" Content="✕" Click="SensorRemove_Click" ToolTip="{local:T Entry.Remove}" Visibility="{Binding RemoveVis}"/>
                                                </Grid>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="↓" Click="SensorDown_Click" ToolTip="{local:T Entry.Down}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="↑" Click="SensorUp_Click" Margin="8,0,0,0" ToolTip="{local:T Entry.Up}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="A+" Click="SizeUp_Click"
                                                        Margin="0" ToolTip="{local:T Entry.SensorLarger}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Width="36" TextAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowMini}" Content="A−" Click="SizeDown_Click"
                                                        Margin="8,0,0,0" ToolTip="{local:T Entry.SensorSmaller}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{DynamicResource FgDim}"/>
                                                <!-- il nome prende lo spazio che resta, fino a 150 px, sempre allineato a sinistra -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource DarkBox}" MaxLength="28"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" LostFocus="NameBox_LostFocus"
                                                             ToolTip="{local:T Entry.SensorName}"/>
                                                </Grid>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" Visibility="{Binding FrameVis}" Foreground="{DynamicResource FgDim}"
                                                       FontSize="11.5" TextWrapping="Wrap" Margin="43,2,0,4" Opacity="{Binding RowOpacity}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                                <!-- La riga "sollevata" mentre la si trascina: immagine della riga, un po' più grande,
                                     con ombra e bordo d'accento. La muove il codice (vedi "trascinamento"). -->
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="DragGhost" Visibility="Collapsed" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                                            CornerRadius="8" Background="{DynamicResource Panel}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="DragGhostScale"/>
                                                <TranslateTransform x:Name="DragGhostMove"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6.5"/>
                                            <Image x:Name="DragGhostImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </Canvas>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <!-- ANTEPRIMA: come apparirà l'overlay, aggiornata a ogni spunta, nome, colore, grandezza e spostamento. -->
                    <Border x:Name="SensPreviewCard" Grid.Column="4" Style="{StaticResource PageCard}" Margin="0" Padding="10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                                <TextBlock Text="&#xE7B3;" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="{local:T Sns.Preview}" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <ContentControl x:Name="SensPreviewHost" Focusable="False"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- OPZIONI: la stessa pagina che prima era una finestra a parte. -->
                <ScrollViewer x:Name="PageOptions" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Border Style="{StaticResource Card}" Padding="24,6,24,22" MaxWidth="560" HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <local:OptionsPage x:Name="OptionsView"/>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Tavolozza dei colori, condivisa da tutte le voci. -->
        <Popup x:Name="ColorPopup" StaysOpen="True" Placement="Bottom" AllowsTransparency="True">
            <local:ColorPicker x:Name="Picker"/>
        </Popup>
    </Grid>
</Window>
