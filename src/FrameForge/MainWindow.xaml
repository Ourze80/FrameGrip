                                        <ListBox Style="{StaticResource CardList}" SelectedIndex="{Binding Font}">
                                            <ListBoxItem>
                                                <StackPanel Width="68">
                                                    <TextBlock Text="123" FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{local:T Font.Mono}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </ListBoxItem>
